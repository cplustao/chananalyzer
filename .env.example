# ChanAnalyzer v2 configuration template.
# Copy this file to .env. Never commit real passwords, tokens, or encryption keys.

# Runtime
ENVIRONMENT=local
AUTH_MODE=local
BACKUP_DOWNLOAD_ENABLED=false
DATABASE_URL=sqlite:///data/chan_v2.db
API_HOST=127.0.0.1
API_PORT=8011
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
TRUSTED_PROXIES=127.0.0.1,::1
WORKER_POLL_SECONDS=1
WORKER_MAX_ATTEMPTS=3
LOG_LEVEL=INFO

# Research reliability gates
RADAR_MIN_CURRENT_COVERAGE=0.99
RADAR_MIN_MA20_COVERAGE=0.95

# Market data
# TUSHARE_TOKEN=replace-with-your-token

# AI provider chain. A provider participates only when both its key and model are configured.
AI_PROVIDER_ORDER=deepseek,siliconflow
DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_API_KEY=replace-with-your-key
# SILICONFLOW_MODEL=replace-with-a-siliconflow-model-id
# SILICONFLOW_API_KEY=replace-with-your-key

# Server deployment (Nginx terminates HTTPS and proxies from a trusted loopback address).
# ENVIRONMENT=server
# AUTH_MODE=admin
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=replace-with-a-long-random-password
# APP_SECRET_KEY=replace-with-at-least-48-random-characters
# COOKIE_SECURE=true
# ALLOWED_ORIGINS=https://research.example.com
# API_HOST=127.0.0.1
# TRUSTED_PROXIES=127.0.0.1,::1
